# ============================================
# Paperef Backend - Environment Variables
# ============================================
#
# This is a template file for development.
# For Docker deployment, use infrastructure/.env
#
# Local development setup:
#   1. Copy this file: cp .env.example .env
#   2. OR create symlink: ln -s ../infrastructure/.env .env
#   3. Generate SECRET_KEY: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   4. Update all values below
#

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://paperef_user:your_password@localhost:5432/paperef

# ============================================
# JWT Authentication
# ============================================
# Secret key for JWT token signing
# MUST be changed in production!
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate-with-secrets-token-urlsafe-32

# JWT algorithm (recommended: HS256)
ALGORITHM=HS256

# Access token expiration time in minutes
# Recommended: 15-30 minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration time in days
# Recommended: 7-30 days
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Email Configuration (Optional)
# ============================================
# SMTP server for sending password reset emails
# For Gmail: smtp.gmail.com
SMTP_HOST=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP authentication
# For Gmail, use your email and app password
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Email sender information
SMTP_FROM_EMAIL=noreply@paperef.com
SMTP_FROM_NAME=Paperef

# ============================================
# Application Settings
# ============================================
# Environment: development, staging, production
ENV=development

# Frontend URL for password reset links
FRONTEND_URL=http://localhost:3000

# Debug mode (True/False)
DEBUG=True
